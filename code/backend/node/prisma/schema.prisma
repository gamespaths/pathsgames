  tsUpdate       String  @default("") @map("ts_update")
  story ListStory @relation(fields: [idStory], references: [id], onDelete: Cascade)
  @@id([id, idStory])
  @@index([uuid])
  @@map("list_global_random_events")
}

model Mission {
  id                 Int     @map("id")
  idStory            Int     @map("id_story")
  uuid               String  @unique @default(uuid())
  idCard             Int?    @map("id_card")
  conditionKey       String? @map("condition_key")
  conditionValueFrom String? @map("condition_value_from")
  conditionValueTo   String? @map("condition_value_to")
  idTextName         Int?    @map("id_text_name")
  idTextDescription  Int?    @map("id_text_description")
  idEventCompleted   Int?    @map("id_event_completed")
  tsInsert           String  @default("") @map("ts_insert")
  tsUpdate           String  @default("") @map("ts_update")
  story ListStory @relation(fields: [idStory], references: [id], onDelete: Cascade)
  @@id([id, idStory])
  @@index([uuid])
  @@map("list_missions")
}

model MissionStep {
  id                 Int     @map("id")
  idStory            Int     @map("id_story")
  uuid               String  @unique @default(uuid())
  idCard             Int?    @map("id_card")
  idMission          Int     @map("id_mission")
  step               Int
  conditionKey       String? @map("condition_key")
  conditionValueFrom String? @map("condition_value_from")
  conditionValueTo   String? @map("condition_value_to")
  idTextName         Int?    @map("id_text_name")
  idTextDescription  Int?    @map("id_text_description")
  idEventCompleted   Int?    @map("id_event_completed")
  tsInsert           String  @default("") @map("ts_insert")
  tsUpdate           String  @default("") @map("ts_update")
  story ListStory @relation(fields: [idStory], references: [id], onDelete: Cascade)
  @@id([id, idStory])
  @@index([uuid])
  @@map("list_missions_steps")
}

// ── Auth (V0.10.1) ─────────────────────────────────────────────────────────

model User {
  id                Int      @id @default(autoincrement())
  uuid              String   @unique @default(uuid())
  username          String   @unique
  passwordHash      String?  @map("password_hash")
  emailAddress      String?  @map("email_address")
  googleIdSso       String?  @map("google_id_sso")
  role              String   @default("PLAYER")
  state             Int      @default(1)
  nickname          String?
  language          String?  @default("en")
  guestCookieToken  String?  @map("guest_cookie_token")
  guestExpiresAt    String?  @map("guest_expires_at")
  themeSelected     String?  @default("default") @map("theme_selected")
  tsRegistration    String   @default("") @map("ts_registration")
  tsLastAccess      String?  @map("ts_last_access")
  tsInsert          String   @default("") @map("ts_insert")
  tsUpdate          String   @default("") @map("ts_update")
  tokens            UserToken[]
  matches           GamingMatch[]
  @@index([uuid])
  @@map("users")
}

model UserToken {
  id           Int     @id @default(autoincrement())
  uuid         String  @unique @default(uuid())
  idUser       Int     @map("id_user")
  refreshToken String  @map("refresh_token")
  expiresAt    String  @map("expires_at")
  revoked      Boolean @default(false)
  tsInsert     String  @default("") @map("ts_insert")
  tsUpdate     String  @default("") @map("ts_update")
  user User @relation(fields: [idUser], references: [id], onDelete: Cascade)
  @@index([uuid])
  @@map("users_tokens")
}

// ── Gaming core (V0.10.6) — usate dalle API match ──────────────────────────

model GamingMatch {
  id                       Int      @id @default(autoincrement())
  uuid                     String   @unique @default(uuid())
  idStory                  Int      @map("id_story")
  name                     String?
  idDifficulty             Int      @map("id_difficulty")
  expCost                  Int      @default(5) @map("exp_cost")
  status                   String   @default("CREATED")
  currentClock             Int      @default(0) @map("current_clock")
  idCurrentWeather         Int?     @map("id_current_weather")
  idUserCreator            Int      @map("id_user_creator")
  timestampStart           DateTime? @map("timestamp_start")
  timestampLockExpiration  DateTime? @map("timestamp_lock_expiration")
  timestampGameover        DateTime? @map("timestamp_gameover")
  timestampEnd             DateTime? @map("timestamp_end")
  idCharacterCurrentTurn   Int?     @map("id_character_current_turn")
  secureLocationParam      Int?     @default(0) @map("secure_location_param")
  counterConsecutivePass   Int      @default(0) @map("counter_consecutive_pass")
  // Colonne locali (non in documentazione) a supporto del contratto API:
  // flag single-player + loadout creatore (validato alla creazione, esposto in match info).
  singlePlayer             Int      @default(1) @map("single_player")
  difficultyUuid           String?  @map("difficulty_uuid")
  progress                 Int      @default(0)
  characterTemplateUuid    String?  @map("character_template_uuid")
  classUuid                String?  @map("class_uuid")
  traitUuids               String[] @map("trait_uuids")
  endedAt                  DateTime? @map("ended_at")
  tsInsert                 String   @default("") @map("ts_insert")
  tsUpdate                 String   @default("") @map("ts_update")
  story    ListStory               @relation(fields: [idStory], references: [id])
  creator  User                    @relation(fields: [idUserCreator], references: [id])
  characters GamingCharacterInstance[]
  traits     GamingCharacterTrait[]
  @@index([uuid])
  @@map("gaming_match")
}

model GamingCharacterInstance {
  id                     Int      @map("id")
  idMatch                Int      @map("id_match")
  uuid                   String   @unique @default(uuid())
  idUser                 Int      @map("id_user")
  idCharacterTemplate    Int      @map("id_character_template")
  dexterity              Int      @default(1)
  intelligence           Int      @default(1)
  constitution           Int      @default(1)
  energy                 Int      @default(0)
  life                   Int      @default(1)
  sad                    Int      @default(0)
  idLocation             Int?     @map("id_location")
  isSleeping             Boolean  @default(false) @map("is_sleeping")
  isComa                 Boolean  @default(false) @map("is_coma")
  clockInComa            Int?     @default(0) @map("clock_in_coma")
  timestampLastPass      DateTime? @map("timestamp_last_pass")
  counterConsecutivePass Int      @default(0) @map("counter_consecutive_pass")
  // Colonne locali (non in documentazione) a supporto del contratto API
  characterTemplateUuid  String?  @map("character_template_uuid")
  classUuid              String?  @map("class_uuid")
  traitUuids             String[] @map("trait_uuids")
  food                   Int      @default(0)
  magic                  Int      @default(0)
  coin                   Int      @default(0)
  locationUuid           String?  @map("location_uuid")
  locationName           String?  @map("location_name")
  tsInsert               String   @default("") @map("ts_insert")
  tsUpdate               String   @default("") @map("ts_update")
  match GamingMatch @relation(fields: [idMatch], references: [id], onDelete: Cascade)
  @@id([id, idMatch])
  @@index([uuid])
  @@map("gaming_character_instance")
}

model GamingCharacterTrait {
  id               Int     @map("id")
  idMatch          Int     @map("id_match")
  uuid             String  @unique @default(uuid())
  idCharacterMatch Int     @map("id_character_match")
  idTraits         Int     @map("id_traits")
  idEvent          Int?    @map("id_event")
  tsInsert         String  @default("") @map("ts_insert")
  tsUpdate         String  @default("") @map("ts_update")
  match GamingMatch @relation(fields: [idMatch], references: [id], onDelete: Cascade)
  @@id([id, idMatch])
  @@index([uuid])
  @@map("gaming_character_traits")
}

model GamingBackpackResource {
  id               Int     @map("id")
  idMatch          Int     @map("id_match")
  uuid             String  @unique @default(uuid())
  idCharacterMatch Int     @map("id_character_match")
  food             Int     @default(0)
  magic            Int     @default(0)
  coin             Int     @default(0)
  tsInsert         String  @default("") @map("ts_insert")
  tsUpdate         String  @default("") @map("ts_update")
  @@id([id, idMatch])
  @@unique([idCharacterMatch, idMatch])
  @@index([uuid])
  @@map("gaming_backpack_resources")
}

model GamingInventoryItem {
  id               Int     @map("id")
  idMatch          Int     @map("id_match")
  uuid             String  @unique @default(uuid())
  idCharacterMatch Int     @map("id_character_match")
  idItem           Int     @map("id_item")
  amount           Int     @default(1)
  state            String? @default("ACTIVE")
  tsInsert         String  @default("") @map("ts_insert")
  tsUpdate         String  @default("") @map("ts_update")
  @@id([id, idMatch])
  @@index([uuid])
  @@map("gaming_inventory_items")
}

// ── System (V0.10.0) ───────────────────────────────────────────────────────

model GlobalGameVersion {
  id          Int    @id
  uuid        String @unique @default(uuid())
  version     String
  description String?
  tsInsert    String @default("") @map("ts_insert")
  tsUpdate    String @default("") @map("ts_update")
  @@map("global_game_version")
}

model GlobalRuntimeVariable {
  id          Int     @id @default(autoincrement())
  uuid        String  @unique @default(uuid())
  type        String
  key         String  @unique
  stringValue String? @map("string_value")
  intValue    Int?    @map("int_value")
  description String?
  minValue    Int?    @map("min_value")
  maxValue    Int?    @map("max_value")
  minVersion  String? @map("min_version")
  maxVersion  String? @map("max_version")
  tsInsert    String  @default("") @map("ts_insert")
  tsUpdate    String  @default("") @map("ts_update")
  @@map("global_runtime_variables")
}

