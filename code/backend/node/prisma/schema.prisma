// ============================================================================
// BOZZA Fase 1 — schema target `list_*` (dominio storia).
// NON ancora attivo: file separato per non rompere il build durante la migrazione.
// Sorgente colonne: code/backend/java/adapter-postgres/.../db/migration/v0/V0.10.*.sql
//                   + v0_19/V0.19.5/6/7 (campi stat). Completare le tabelle marcate TODO.
// Convenzioni Prisma:
//   - tabelle: @@map("list_xxx"); colonne: @map("snake_case")
//   - PK composita: @@id([id, idStory]) (list_stories → id singolo)
//   - uuid: @unique secondario; id_text_* risolti a runtime su list_texts
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Story core (V0.10.2) ───────────────────────────────────────────────────

model ListStory {
  id                      Int      @id @default(autoincrement())
  uuid                    String   @unique @default(uuid())
  idCard                  Int?     @map("id_card")
  idTextTitle             Int?     @map("id_text_title")
  idTextDescription       Int?     @map("id_text_description")
  author                  String?
  versionMin              String?  @map("version_min")
  versionMax              String?  @map("version_max")
  idLocationStart         Int?     @map("id_location_start")
  idImage                 Int?     @map("id_image")
  idLocationAllPlayerComa Int?     @map("id_location_all_player_coma")
  idEventAllPlayerComa    Int?     @map("id_event_all_player_coma")
  idTextClockSingular     Int?     @default(10) @map("id_text_clock_singular")
  idTextClockPlural       Int?     @default(11) @map("id_text_clock_plural")
  idEventEndGame          Int?     @map("id_event_end_game")
  idTextCopyright         Int?     @map("id_text_copyright")
  linkCopyright           String?  @map("link_copyright")
  idCreator               Int?     @map("id_creator")
  category                String?
  group                   String?  @map("group")
  visibility              String   @default("PUBLIC")
  priority                Int      @default(0)
  peghi                   Int      @default(0)
  tsInsert                String   @default("") @map("ts_insert")
  tsUpdate                String   @default("") @map("ts_update")

  difficulties     Difficulty[]
  keys             StoryKey[]
  classes          StoryClass[]
  classBonuses     ClassBonus[]
  traits           Trait[]
  templates        CharacterTemplate[]
  texts            StoryText[]
  creators         Creator[]
  cards            Card[]
  locations        Location[]
  locationNeighbors LocationNeighbor[]
  items            Item[]
  itemEffects      ItemEffect[]
  weatherRules     WeatherRule[]
  events           Event[]
  eventEffects     EventEffect[]
  choices          Choice[]
  choiceConditions ChoiceCondition[]
  choiceEffects    ChoiceEffect[]
  globalRandomEvents GlobalRandomEvent[]
  missions         Mission[]
  missionSteps     MissionStep[]
  matches          GamingMatch[]

  @@index([uuid])
  @@index([visibility])
  @@index([category])
  @@index([group])
  @@map("list_stories")
}

model Difficulty {
  id                    Int     @map("id")
  idStory               Int     @map("id_story")
  uuid                  String  @unique @default(uuid())
  idTextName            Int?    @map("id_text_name")
  idTextDescription     Int?    @map("id_text_description")
  idCard                Int?    @map("id_card")
  expCost               Int     @default(5)  @map("exp_cost")
  maxWeight             Int     @default(10) @map("max_weight")
  minCharacter          Int     @default(1)  @map("min_character")
  maxCharacter          Int     @default(4)  @map("max_character")
  costHelpComa          Int     @default(3)  @map("cost_help_coma")
  costMaxCharacteristics Int    @default(2)  @map("cost_max_characteristics")
  numberMaxFreeAction   Int     @default(0)  @map("number_max_free_action")
  // V0.19.7 stat columns
  life                  Int     @default(0)
  energy                Int     @default(0)
  sad                   Int     @default(0)
  dexterity             Int     @default(0)
  intelligence          Int     @default(0)
  constitution          Int     @default(0)
  weight                Int     @default(0)
  traitCostPositiveBudget Int?  @map("trait_cost_positive_budget")
  traitCostNegativeBudget Int?  @map("trait_cost_negative_budget")
  tsInsert              String  @default("") @map("ts_insert")
  tsUpdate              String  @default("") @map("ts_update")

  story ListStory @relation(fields: [idStory], references: [id], onDelete: Cascade)

  @@id([id, idStory])
  @@index([uuid])
  @@map("list_stories_difficulty")
}

model StoryKey {
  id                Int     @map("id")
  idStory           Int     @map("id_story")
  uuid              String  @unique @default(uuid())
  idCard            Int?    @map("id_card")
  name              String
  value             String?
  idTextDescription Int?    @map("id_text_description")
  group             String? @map("group")
  priority          Int     @default(0)
  visibility        String  @default("PUBLIC")
  tsInsert          String  @default("") @map("ts_insert")
  tsUpdate          String  @default("") @map("ts_update")

  story ListStory @relation(fields: [idStory], references: [id], onDelete: Cascade)

  @@id([id, idStory])
  @@index([uuid])
  @@map("list_keys")
}

model StoryClass {
  id                Int     @map("id")
  idStory           Int     @map("id_story")
  uuid              String  @unique @default(uuid())
  idCard            Int?    @map("id_card")
  idTextName        Int?    @map("id_text_name")
  idTextDescription Int?    @map("id_text_description")
  weightMax         Int     @default(10) @map("weight_max")
  dexterityBase     Int     @default(1)  @map("dexterity_base")
  intelligenceBase  Int     @default(1)  @map("intelligence_base")
  constitutionBase  Int     @default(1)  @map("constitution_base")
  tsInsert          String  @default("") @map("ts_insert")
  tsUpdate          String  @default("") @map("ts_update")

  story  ListStory    @relation(fields: [idStory], references: [id], onDelete: Cascade)
  bonuses ClassBonus[]

  @@id([id, idStory])
  @@index([uuid])
  @@map("list_classes")
}

model ClassBonus {
  id                Int     @map("id")
  idStory           Int     @map("id_story")
  uuid              String  @unique @default(uuid())
  idCard            Int?    @map("id_card")
  idClass           Int     @map("id_class")
  statistic         String
  value             Int     @default(0)
  idTextName        Int?    @map("id_text_name")
  idTextDescription Int?    @map("id_text_description")
  tsInsert          String  @default("") @map("ts_insert")
  tsUpdate          String  @default("") @map("ts_update")

  story ListStory  @relation(fields: [idStory], references: [id], onDelete: Cascade)
  class StoryClass @relation(fields: [idClass, idStory], references: [id, idStory], onDelete: Cascade)

  @@id([id, idStory])
  @@index([uuid])
  @@map("list_classes_bonus")
}

model Trait {
  id                Int     @map("id")
  idStory           Int     @map("id_story")
  uuid              String  @unique @default(uuid())
  idCard            Int?    @map("id_card")
  idClassPermitted  Int?    @map("id_class_permitted")
  idClassProhibited Int?    @map("id_class_prohibited")
  idTextName        Int?    @map("id_text_name")
  idTextDescription Int?    @map("id_text_description")
  costPositive      Int     @default(0) @map("cost_positive")
  costNegative      Int     @default(0) @map("cost_negative")
  // V0.19.6 stat-delta columns
  life              Int     @default(0)
  energy            Int     @default(0)
  sad               Int     @default(0)
  dexterity         Int     @default(0)
  intelligence      Int     @default(0)
  constitution      Int     @default(0)
  weight            Int     @default(0)
  tsInsert          String  @default("") @map("ts_insert")
  tsUpdate          String  @default("") @map("ts_update")

  story ListStory @relation(fields: [idStory], references: [id], onDelete: Cascade)

  @@id([id, idStory])
  @@index([uuid])
  @@map("list_traits")
}

model CharacterTemplate {
  idTipo            Int     @map("id_tipo")
  idStory           Int     @map("id_story")
  uuid              String  @unique @default(uuid())
  idCard            Int?    @map("id_card")
  idTextName        Int?    @map("id_text_name")
  idTextDescription Int?    @map("id_text_description")
  lifeMax           Int     @default(10) @map("life_max")
  energyMax         Int     @default(10) @map("energy_max")
  sadMax            Int     @default(10) @map("sad_max")
  dexterityStart    Int     @default(1)  @map("dexterity_start")
  intelligenceStart Int     @default(1)  @map("intelligence_start")
  constitutionStart Int     @default(1)  @map("constitution_start")
  // V0.19.5
  idClassPermitted  Int?    @map("id_class_permitted")
  idClassProhibited Int?    @map("id_class_prohibited")
  tsInsert          String  @default("") @map("ts_insert")
  tsUpdate          String  @default("") @map("ts_update")

  story ListStory @relation(fields: [idStory], references: [id], onDelete: Cascade)

  @@id([idTipo, idStory])
  @@index([uuid])
  @@map("list_character_templates")
}

// ── Story content (V0.10.5) ────────────────────────────────────────────────

model Creator {
  id           Int     @map("id")
  idStory      Int     @map("id_story")
  uuid         String  @unique @default(uuid())
  idText       Int?    @map("id_text")
  link         String?
  url          String?
  urlImage     String? @map("url_image")
  urlEmote     String? @map("url_emote")
  urlInstagram String? @map("url_instagram")
  idCard       Int?    @map("id_card")
  tsInsert     String  @default("") @map("ts_insert")
  tsUpdate     String  @default("") @map("ts_update")

  story ListStory @relation(fields: [idStory], references: [id], onDelete: Cascade)

  @@id([id, idStory])
  @@index([uuid])
  @@map("list_creator")
}

model Card {
  id                Int     @map("id")
  idStory           Int     @map("id_story")
  uuid              String  @unique @default(uuid())
  urlImmage         String? @map("url_immage")
  idTextTitle       Int?    @map("id_text_title")
  idTextDescription Int?    @map("id_text_description")
  idTextCopyright   Int?    @map("id_text_copyright")
  linkCopyright     String? @map("link_copyright")
  idCreator         Int?    @map("id_creator")
  alternativeImage  String? @map("alternative_image")
  awesomeIcon       String? @map("awesome_icon")
  styleMain         String? @map("style_main")
  styleDetail       String? @map("style_detail")
  // colonne aggiunte da migration successive (V0.10.13 + Step15/17)
  styleImageLittle  String? @map("style_image_little")
  styleImageMedium  String? @map("style_image_medium")
  styleImageLarge   String? @map("style_image_large")
  cardType          String? @map("card_type")
  idCard            Int?    @map("id_card")
  idTextName        Int?    @map("id_text_name")
  tsInsert          String  @default("") @map("ts_insert")
  tsUpdate          String  @default("") @map("ts_update")

  story ListStory @relation(fields: [idStory], references: [id], onDelete: Cascade)

  @@id([id, idStory])
  @@index([uuid])
  @@map("list_cards")
}

model StoryText {
  id              Int     @map("id")
  idStory         Int     @map("id_story")
  uuid            String  @unique @default(uuid())
  idText          Int     @map("id_text")
  lang            String  @default("en")
  shortText       String? @map("short_text")
  longText        String? @map("long_text")
  idTextCopyright Int?    @map("id_text_copyright")
  linkCopyright   String? @map("link_copyright")
  idCreator       Int?    @map("id_creator")
  tsInsert        String  @default("") @map("ts_insert")
  tsUpdate        String  @default("") @map("ts_update")

  story ListStory @relation(fields: [idStory], references: [id], onDelete: Cascade)

  @@id([id, idStory])
  @@unique([idStory, idText, lang])
  @@index([uuid])
  @@index([idStory, idText])
  @@map("list_texts")
}

// ── Story locations & items (V0.10.3) ──────────────────────────────────────
// Nota: i FK interni composite (id_class, id_location, id_event, …) restano
// colonne Int senza relazione Prisma — l'integrità è gestita dall'app/import.

model Location {
  id                              Int     @map("id")
  idStory                         Int     @map("id_story")
  uuid                            String  @unique @default(uuid())
  idCard                          Int?    @map("id_card")
  idTextName                      Int?    @map("id_text_name")
  idTextDescription               Int?    @map("id_text_description")
  idTextNarrative                 Int?    @map("id_text_narrative")
  idImage                         Int?    @map("id_image")
  isSafe                          Int     @default(0) @map("is_safe")
  costEnergyEnter                 Int     @default(1) @map("cost_energy_enter")
  counterTime                     Int?    @map("counter_time")
  idEventIfCounterZero            Int?    @map("id_event_if_counter_zero")
  secureParam                     Int?    @default(0) @map("secure_param")
  idEventIfCharacterStartTime     Int?    @map("id_event_if_character_start_time")
  idEventIfCharacterEnterFirstTime Int?   @map("id_event_if_character_enter_first_time")
  idEventIfFirstTime              Int?    @map("id_event_if_first_time")
  idEventNotFirstTime             Int?    @map("id_event_not_first_time")
  priorityAutomaticEvent          Int?    @default(0) @map("priority_automatic_event")
  idAudio                         Int?    @map("id_audio")
  maxCharacters                   Int?    @default(100) @map("max_characters")
  tsInsert                        String  @default("") @map("ts_insert")
  tsUpdate                        String  @default("") @map("ts_update")
  story ListStory @relation(fields: [idStory], references: [id], onDelete: Cascade)
  @@id([id, idStory])
  @@index([uuid])
  @@map("list_locations")
}

model LocationNeighbor {
  id                     Int     @map("id")
  idStory                Int     @map("id_story")
  uuid                   String  @unique @default(uuid())
  idLocationFrom         Int     @map("id_location_from")
  idLocationTo           Int     @map("id_location_to")
  direction              String
  flagBack               Int     @default(0) @map("flag_back")
  conditionRegistryKey   String? @map("condition_registry_key")
  conditionRegistryValue String? @map("condition_registry_value")
  energyCost             Int?    @default(0) @map("energy_cost")
  idTextGo               Int?    @map("id_text_go")
  idTextBack             Int?    @map("id_text_back")
  tsInsert               String  @default("") @map("ts_insert")
  tsUpdate               String  @default("") @map("ts_update")
  story ListStory @relation(fields: [idStory], references: [id], onDelete: Cascade)
  @@id([id, idStory])
  @@index([uuid])
  @@map("list_locations_neighbors")
}

model Item {
  id                Int     @map("id")
  idStory           Int     @map("id_story")
  uuid              String  @unique @default(uuid())
  idCard            Int?    @map("id_card")
  idTextName        Int?    @map("id_text_name")
  idTextDescription Int?    @map("id_text_description")
