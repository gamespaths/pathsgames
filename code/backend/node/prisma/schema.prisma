  isConsumabile     Int     @default(1) @map("is_consumabile")
  idClassPermitted  Int?    @map("id_class_permitted")
  idClassProhibited Int?    @map("id_class_prohibited")
  tsInsert          String  @default("") @map("ts_insert")
  tsUpdate          String  @default("") @map("ts_update")
  story ListStory @relation(fields: [idStory], references: [id], onDelete: Cascade)
  @@id([id, idStory])
  @@index([uuid])
  @@map("list_items")
}

model ItemEffect {
  id                Int     @map("id")
  idStory           Int     @map("id_story")
  uuid              String  @unique @default(uuid())
  idItem            Int     @map("id_item")
  idTextName        Int?    @map("id_text_name")
  idTextDescription Int?    @map("id_text_description")
  effectCode        String  @map("effect_code")
  effectValue       Int     @default(0) @map("effect_value")
  tsInsert          String  @default("") @map("ts_insert")
  tsUpdate          String  @default("") @map("ts_update")
  story ListStory @relation(fields: [idStory], references: [id], onDelete: Cascade)
  @@id([id, idStory])
  @@index([uuid])
  @@map("list_items_effects")
}

model WeatherRule {
  id                      Int     @map("id")
  idStory                 Int     @map("id_story")
  uuid                    String  @unique @default(uuid())
  idCard                  Int?    @map("id_card")
  idTextName              Int?    @map("id_text_name")
  idTextDescription       Int?    @map("id_text_description")
  probability             Int     @default(0)
  costMoveSafeLocation    Int?    @default(0) @map("cost_move_safe_location")
  costMoveNotSafeLocation Int?    @default(0) @map("cost_move_not_safe_location")
  conditionKey            String? @map("condition_key")
  conditionKeyValue       String? @map("condition_key_value")
  timeFrom                Int?    @map("time_from")
  timeTo                  Int?    @map("time_to")
  idText                  Int?    @map("id_text")
  active                  Int     @default(1)
  priority                Int?    @default(0)
  deltaEnergy             Int?    @default(0) @map("delta_energy")
  idEvent                 Int?    @map("id_event")
  tsInsert                String  @default("") @map("ts_insert")
  tsUpdate                String  @default("") @map("ts_update")
  story ListStory @relation(fields: [idStory], references: [id], onDelete: Cascade)
  @@id([id, idStory])
  @@index([uuid])
  @@map("list_weather_rules")
}

// ── Story events & choices (V0.10.4) ───────────────────────────────────────

model Event {
  id                     Int     @map("id")
  idStory                Int     @map("id_story")
  uuid                   String  @unique @default(uuid())
  idCard                 Int?    @map("id_card")
  idSpecificLocation     Int?    @map("id_specific_location")
  idTextName             Int?    @map("id_text_name")
  idTextDescription      Int?    @map("id_text_description")
  type                   String  @default("NORMAL")
  costEnery              Int?    @default(0) @map("cost_enery")
  flagEndTime            Int     @default(0) @map("flag_end_time")
  characteristicToAdd    String? @map("characteristic_to_add")
  characteristicToRemove String? @map("characteristic_to_remove")
  keyToAdd               String? @map("key_to_add")
  keyValueToAdd          String? @map("key_value_to_add")
  idItemToAdd            Int?    @map("id_item_to_add")
  idWeather              Int?    @map("id_weather")
  idEventNext            Int?    @map("id_event_next")
  coinCost               Int?    @default(0) @map("coin_cost")
  tsInsert               String  @default("") @map("ts_insert")
  tsUpdate               String  @default("") @map("ts_update")
  story ListStory @relation(fields: [idStory], references: [id], onDelete: Cascade)
  @@id([id, idStory])
  @@index([uuid])
  @@map("list_events")
}

model EventEffect {
  id             Int     @map("id")
  idStory        Int     @map("id_story")
  uuid           String  @unique @default(uuid())
  idCard         Int?    @map("id_card")
  idEvent        Int     @map("id_event")
  statistics     String?
  value          Int?    @default(0)
  target         String? @default("ALL")
  traitsToAdd    String? @map("traits_to_add")
  traitsToRemove String? @map("traits_to_remove")
  targetClass    Int?    @map("target_class")
  idItemTarget   Int?    @map("id_item_target")
  itemAction     String? @map("item_action")
  tsInsert       String  @default("") @map("ts_insert")
  tsUpdate       String  @default("") @map("ts_update")
  story ListStory @relation(fields: [idStory], references: [id], onDelete: Cascade)
  @@id([id, idStory])
  @@index([uuid])
  @@map("list_events_effects")
}

model Choice {
  id                Int     @map("id")
  idStory           Int     @map("id_story")
  uuid              String  @unique @default(uuid())
  idCard            Int?    @map("id_card")
  idEvent           Int?    @map("id_event")
  idLocation        Int?    @map("id_location")
  priority          Int?    @default(0)
  idTextName        Int?    @map("id_text_name")
  idTextDescription Int?    @map("id_text_description")
  idTextNarrative   Int?    @map("id_text_narrative")
  idEventTorun      Int?    @map("id_event_torun")
  limitSad          Int?    @map("limit_sad")
  limitDex          Int?    @map("limit_dex")
  limitInt          Int?    @map("limit_int")
  limitCos          Int?    @map("limit_cos")
  otherwiseFlag     Int     @default(0) @map("otherwise_flag")
  isProgress        Int     @default(0) @map("is_progress")
  logicOperator     String? @default("AND") @map("logic_operator")
  tsInsert          String  @default("") @map("ts_insert")
  tsUpdate          String  @default("") @map("ts_update")
  story ListStory @relation(fields: [idStory], references: [id], onDelete: Cascade)
  @@id([id, idStory])
  @@index([uuid])
  @@map("list_choices")
}

model ChoiceCondition {
  id                Int     @map("id")
  idStory           Int     @map("id_story")
  uuid              String  @unique @default(uuid())
  idChoices         Int     @map("id_choices")
  type              String
  key               String?
  value             String?
  operator          String? @default("=")
  idTextName        Int?    @map("id_text_name")
  idTextDescription Int?    @map("id_text_description")
  tsInsert          String  @default("") @map("ts_insert")
  tsUpdate          String  @default("") @map("ts_update")
  story ListStory @relation(fields: [idStory], references: [id], onDelete: Cascade)
  @@id([id, idStory])
  @@index([uuid])
  @@map("list_choices_conditions")
}

model ChoiceEffect {
  id            Int     @map("id")
  idStory       Int     @map("id_story")
  uuid          String  @unique @default(uuid())
  idChoices     Int     @map("id_choices")
  idScelta      Int?    @map("id_scelta")
  flagGroup     Int     @default(0) @map("flag_group")
  statistics    String?
  value         Int?    @default(0)
  idText        Int?    @map("id_text")
  key           String?
  valueToAdd    String? @map("value_to_add")
  valueToRemove String? @map("value_to_remove")
  tsInsert      String  @default("") @map("ts_insert")
  tsUpdate      String  @default("") @map("ts_update")
  story ListStory @relation(fields: [idStory], references: [id], onDelete: Cascade)
  @@id([id, idStory])
  @@index([uuid])
  @@map("list_choices_effects")
}

model GlobalRandomEvent {
  id             Int     @map("id")
  idStory        Int     @map("id_story")
  uuid           String  @unique @default(uuid())
  idCard         Int?    @map("id_card")
