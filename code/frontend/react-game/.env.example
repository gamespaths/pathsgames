VITE_GTM_ID=GTM-xxxxxxxx

VITE_API_URL=http://localhost:8042
# JSON array of selectable backend servers (shown in the Footer switcher).
# The first entry is the default. Leave as [] to fall back to VITE_API_URL.
# Example: '[{"label":"Local","url":"http://localhost:8042"},{"label":"AWS","url":"https://api-dev.paths.games/"}]'
VITE_DEFAULT_SERVERS='[{"label":"Test server","url":"https://api.example.com"}]'
# Seconds the StartMatch page waits before creating the match and before
# entering the game. Default 20.
VITE_MATCH_START_DELAY=20

# Cloudflare Turnstile site key for anti-bot protection on match creation.
# Get yours at https://dash.cloudflare.com → Turnstile → Add site.
# Use the Cloudflare test key (always passes) for local dev:
#   VITE_CF_TURNSTILE_KEY=1x00000000000000000000AA
# Leave unset to disable the widget entirely (dev bypass).
VITE_CF_TURNSTILE_KEY=
VITE_TURNSTILE_DELAY_BEFORE_START=1

# Per-element Turnstile render mode: "always" (visible widget, default) or
# "interaction-only" (invisible until Cloudflare requires a challenge).
#   _HOME   → HomePage antibot gate
#   _START  → start-game button (ConfigView / mobile)
#   _GUEST  → guest user modal (matches list)
VITE_TURNSTILE_APPEARANCE_HOME=always
VITE_TURNSTILE_APPEARANCE_START=always
VITE_TURNSTILE_APPEARANCE_GUEST=always

# Minutes to remember a passed HomePage antibot check (first-party
# pathsgames.turnstilePass cookie) before re-running Turnstile. Default 30 = 30 minutes!
VITE_TURNSTILE_PASS_TTL_MINUTES=3000

# "Resume" on a home story card jumps straight into the running match, skipping the
# guest-player modal. Off by default: the modal still lists every match.
VITE_RESUME_WITHOUT_MODAL=false

# Append the teaser stories of src/data/stories.json to the home catalog. They cannot be
# played: their card shows a "Coming Soon" label instead of the button.
VITE_ADD_COMING_SOON_STORIES=false
