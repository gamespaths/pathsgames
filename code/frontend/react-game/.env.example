VITE_GTM_ID=GTM-xxxxxxxx
VITE_API_URL=http://localhost:8042
# Comma-list of server entries as JSON array. Leave as [] to use built-in defaults (mock + localhost).
# Example: '[{"label":"Mock","url":"mock"},{"label":"Local","url":"http://localhost:8042"},{"label":"AWS","url":"https://api-dev.paths.games/"}]'
VITE_DEFAULT_SERVERS=[]
# Seconds the StartMatch page waits before creating the match and before
# entering the game. Default 20.
VITE_MATCH_START_DELAY=20