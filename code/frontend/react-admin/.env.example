VITE_PORT=5172
# The admin console only calls /api/admin/** — point it at the dedicated admin endpoint:
# the admin port 8044 (Java/Python/AWS lambda) or the AdminApiUrl output of the AWS stack.
VITE_DEFAULT_SERVERS='[{"label":"Local Admin (8044)","url":"http://localhost:8044"},{"label":"AWS Admin","url":"https://xxxxxx.execute-api.us-east-2.amazonaws.com/dev/"}]'

# Step 40 — environment code shown as a header badge (dev → "Local", test, alpha, beta…).
# Empty or "prod" shows nothing. The owner sets it per build.
VITE_ENV_BADGE=
