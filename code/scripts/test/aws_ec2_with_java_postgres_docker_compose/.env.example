# Paths Games — EC2 Java + PostgreSQL + Nginx
# Copy to .env and fill in values.
# start.sh loads .env automatically.

# ── AWS ──────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-2
EC2_KEY_NAME=paths-games-ohio
EC2_INSTANCE_TYPE=t3.small

# ── Git repository ────────────────────────────────────────────────────────────
GIT_REPO_URL=https://github.com/alnao/pathsgames.git
GIT_BRANCH=main

# ── PostgreSQL (forwarded to java_docker_compose .env) ───────────────────────
DB_NAME=pathsgames
DB_USERNAME=pathsgames
DB_PASSWORD=changeme_strong_password

# ── Java backend ──────────────────────────────────────────────────────────────
JWT_SECRET=PathsGamesDevSecret2026_MustBeAtLeast32Chars!

# ── Nginx public port (what EC2 exposes) ─────────────────────────────────────
NGINX_PORT=8042

# ── Admin IP whitelist (comma-separated) ─────────────────────────────────────
# start.sh adds the current machine's public IP automatically.
# Example: ADMIN_IP_WHITELIST=10.0.0.1,192.168.1.100
ADMIN_IP_WHITELIST=

# ── Domains allowed on port 8042 (comma-separated, DNS-resolved at start) ────
ALLOWED_DOMAINS=paths.games,www.paths.games,test.paths.games

# ── Route53 DNS (optional) ────────────────────────────────────────────────────
# If set, start.sh creates an A record pointing to the EC2 public IP,
# and stop.sh deletes it on teardown.
# ROUTE53_HOSTED_ZONE_ID: ID of the hosted zone (e.g. Z1D633PJN98FT9)
# ROUTE53_RECORD_NAME:    FQDN to create/delete (e.g. api-test-server2.paths.games)
ROUTE53_HOSTED_ZONE_ID=
ROUTE53_RECORD_NAME=api-test-server2.paths.games

INSTANCE_NAME=api-test-server2
