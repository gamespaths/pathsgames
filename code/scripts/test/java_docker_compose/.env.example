# Paths Games — Java + PostgreSQL + Nginx Docker Compose
# Copy this file to .env and fill in your values.
# start.sh will load .env automatically.

# ── PostgreSQL ───────────────────────────────────────────────────────────────
DB_NAME=pathsgames
DB_USERNAME=pathsgames
DB_PASSWORD=changeme_strong_password

# ── Java backend ─────────────────────────────────────────────────────────────
JWT_SECRET=PathsGamesDevSecret2026_MustBeAtLeast32Chars!

# ── Nginx public port ────────────────────────────────────────────────────────
# Port exposed on the host machine (http://localhost:NGINX_PORT)
NGINX_PORT=8042

# ── Admin IP whitelist ───────────────────────────────────────────────────────
# Comma-separated list of IPs allowed to call /api/admin/** endpoints.
# start.sh will ALSO add the current machine's public IP automatically.
# Leave empty to rely only on auto-detected IP.
# Example: ADMIN_IP_WHITELIST=10.0.0.1,192.168.1.100
ADMIN_IP_WHITELIST=1.2.3.4
