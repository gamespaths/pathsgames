# Copy this file to .env in the repository root and fill the secret values.
# Do NOT commit .env containing real secrets.

# JWT secret used by the backend (dev default is provided but you can override)
JWT_SECRET=

# Admin JWT token used by Robot tests (optional - can be generated dynamically)
# Example: ROBOT_VAR_ADMIN_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
ROBOT_VAR_ADMIN_TOKEN=

# Sonar scanner login token
SONAR_LOGIN_TOKEN_JAVA=
SONAR_LOGIN_TOKEN=


# AWS Website deployment (optional - only needed if you want to deploy the website to AWS S3/CloudFront)
S3_BUCKET_WEBSITE=
S3_BUCKET_WEBSITE_TEST=
CLOUDFRONT_DISTRIBUTION_ID=
CLOUDFRONT_DISTRIBUTION_ID_TEST=

# AWS Backend CloudFormation params (optional - only needed if you want to deploy the backend to AWS using CloudFormation)
ENVIRONMENT_NAME=dev
STACK_NAME=pathsgames-dev 
S3_BUCKET=pathsgames-dev
AWS_REGION=us-east-2
AWS_CustomDomainName=xxxx.domain.com
AWS_CustomDomainCertificateArn=arn:aws:acm:us-east-2:xxxxxxxxxx:certificate/yyyyyyyyyy
AWS_CustomDomainHostedZoneId=Zzzzzzzzzzzzzzzzzzzzz
# Comma-separated CORS origins (no spaces). Leave empty to use the template default (localhost only).
AWS_CorsAllowOrigins=http://localhost:3000,http://localhost:5172,http://localhost:5174,http://localhost:5500


# Cloudflare Turnstile keys.
# For dev/AWS robot tests use the Cloudflare "always-passes" test keys so the
# siteverify API accepts any token without a real browser widget:
#   TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# For production use the real keys from the Cloudflare dashboard.
TURNSTILE_SITE_KEY=0xAAAAA
TURNSTILE_SECRET_KEY=0xAAAAA