# Copy this file to .env in the repository root and fill the secret values.
# Do NOT commit .env containing real secrets.

# VERSION
VERSION=1.9.0

# ADmin IP whitelist (comma-separated, no spaces). The current machine's public IP will be added automatically by start.sh, so you can leave this empty if you only need to allow from the current machine.
# Example: ADMIN_IP_WHITELIST=
ADMIN_IP_WHITELIST=1.2.3.4
# v0.41.0 — meaning of an empty allow-list on the AWS test stack: nobody (admin API closed, default) or everybody.
AWS_TEST_APIGW_ADMIN_IP_EMPTY_MEANS=nobody

# JWT secret used by the backend (dev default is provided but you can override)
# v0.41.0 — set your own: openssl rand -base64 48. Outside dev/test every backend refuses the committed default;
# the Robot scripts, the AWS test deploy, the starter and stress scripts all sign with this value.
JWT_SECRET=

# v1.2.0 — iss (stage + backend) and aud of every token; empty = pathsgames-<env>-<java|python|aws> / paths-games
JWT_ISSUER=
JWT_AUDIENCE=

# v1.7.0 — HMAC pepper of the banned Google subjects and emails (Java and Python); empty = committed default,
# accepted only in dev/test. One value per stage, never rotated: openssl rand -base64 48.
BANNED_SUBJECT_PEPPER=

# v1.2.0 — Google sign-in of the LOCAL backends: the dev client (non-prod Google project); stages use AWS_<ENV>_LAMBDA_GOOGLE_CLIENT_ID;
# GOOGLE_ENABLED=false only on test, for trials; per-IP limit of POST /api/auth/google (0 = off)
GOOGLE_CLIENT_ID=
GOOGLE_ENABLED=true
RATE_LIMIT_GOOGLE_PER_IP=30
# v1.2.0 — lifetime of the bootstrapped admin token (30 only on the AWS prod environment)
ADMIN_TOKEN_DAYS=365
# v1.7.0 — sessions of the LOCAL backends: refresh tokens per user (cap), refresh lifetime in days (sliding,
# guests capped at 180) and SameSite of the auth cookies (Lax; None only when the API is on another site)
MAX_TOKENS_PER_USER=12
REFRESH_TOKEN_DAYS=250
COOKIE_SAME_SITE=Lax
# v1.2.0 — the AWS code default of ALLOW_MOCK_ACCESS is false: set true here only for local dev
ALLOW_MOCK_ACCESS=false

# Admin JWT token used by Robot tests (optional: v1.2.0 the suites get a real admin from /api/dev/admin-token)
# Example: ROBOT_VAR_ADMIN_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# v1.2.0 — a real admin user and its token: code/scripts/dev/mint_admin_token.sh [--backend java|python|aws]
ROBOT_VAR_ADMIN_TOKEN=

# Sonar scanner login token
SONAR_LOGIN_TOKEN_JAVA=
SONAR_LOGIN_TOKEN=


# AWS Website deployment of react-game on test (code/scripts/test/aws/deploy_frontend-game_on_aws.sh).
# v0.42.0 — the landing (code/website/html) is retired: the alpha site uses the *_ALPHA keys below.
AWS_TEST_S3_BUCKET_WEBSITE=
AWS_TEST_CLOUDFRONT_DISTRIBUTION_ID=

# AWS Backend CloudFormation params (optional - only needed if you want to deploy the backend to AWS using CloudFormation)
AWS_TEST_SAM_ENVIRONMENT_NAME=test
AWS_TEST_SAM_STACK_NAME=
AWS_TEST_S3_BUCKET_BASE=
AWS_TEST_REGION=us-east-2
AWS_PROD_REGION=us-east-1


AWS_TEST_APIGW_CUSTOM_DOMAIN=xxxx.domain.com
AWS_TEST_ACM_DOMAIN_CERTIFICATE_ARN=arn:aws:acm:us-east-2:xxxxxxxxxx:certificate/yyyyyyyyyy
AWS_TEST_ROUTE53_DOMAIN_HOSTED_ZONE=Zzzzzzzzzzzzzzzzzzzzz
# Comma-separated CORS origins (no spaces). Leave empty to use the template default (localhost only).
AWS_TEST_APIGW_CORS_ORIGINS=http://localhost:3000,http://localhost:5172,http://localhost:5174,http://localhost:5500
# Admin HTTP API of the test stack (AdminApiUrl output); empty = the Robot script reads it from CloudFormation.
AWS_TEST_APIGW_ADMIN_API_URL=


# Cloudflare Turnstile keys.
# For dev/AWS robot tests use the Cloudflare "always-passes" test keys so the
# siteverify API accepts any token without a real browser widget:
#   TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# For production use the real keys from the Cloudflare dashboard.
TURNSTILE_SITE_KEY=0xAAAAA
TURNSTILE_SECRET_KEY=0xAAAAA
# emtpy for prod, into test env need to set a token value to bypass the turnstile in robot tests, can be any string when using the test keys
TURNSTILE_BYPASS_TOKEN_TEST=
# Bypass token sent by Robot and the AWS stress run; the AWS test deploy prefers it to TURNSTILE_BYPASS_TOKEN_TEST.
TURNSTILE_BYPASS_TOKEN_ROBOT=
# v1.9.0 — Turnstile secret of the AWS test stack (aws_backend_deploy.sh): empty = validation OFF;
# when the line is missing the deploy falls back to TURNSTILE_SECRET_KEY.
AWS_TEST_LAMBDA_TURNSTILE_SECRET_KEY=

# v0.37.7 — Step 41 security. Rate limits are per source IP per window (fixed window):
# 0 disables a bucket. The same names without _TEST are read by the
# Java (application.yml) and Python (config.py) backends; the AWS test stack takes the _TEST ones.
# v0.41.0 — code defaults 20/20 per IP per hour and 10 matches per guest per day; the Robot, starter
# and EC2 scripts force 0 (Robot mints hundreds of guests from one address), the AWS test deploy uses the _TEST ones.
RATE_LIMIT_GUEST_PER_IP=20
RATE_LIMIT_MATCH_PER_IP=20
RATE_LIMIT_WINDOW_SECONDS=3600
RATE_LIMIT_MATCH_PER_GUEST=10
RATE_LIMIT_MATCH_PER_GUEST_WINDOW_SECONDS=86400
AWS_TEST_LAMBDA_RATE_LIMIT_GUEST_PER_IP=0
AWS_TEST_LAMBDA_RATE_LIMIT_MATCH_PER_IP=0
AWS_TEST_LAMBDA_RATE_LIMIT_WINDOW_SECONDS=3600
AWS_TEST_LAMBDA_RATE_LIMIT_MATCH_PER_GUEST=0
AWS_TEST_LAMBDA_RATE_LIMIT_MATCH_PER_GUEST_WINDOW_SECONDS=86400
# v1.2.0 — Google sign-in on the AWS test stack and the EC2 test servers: the test client (non-prod Google project)
AWS_TEST_LAMBDA_GOOGLE_CLIENT_ID=
AWS_TEST_LAMBDA_GOOGLE_ENABLED=true
AWS_TEST_LAMBDA_RATE_LIMIT_GOOGLE_PER_IP=0
# v1.7.0 — sessions per user and SameSite of the auth cookies (None: the test pages call execute-api URLs)
AWS_TEST_LAMBDA_MAX_SESSIONS_PER_USER=12
AWS_TEST_LAMBDA_COOKIE_SAME_SITE=None
# v0.41.0 — daily cleanup of the guests idle for N days that created no match (00:42 UTC, at most N per run).
GUEST_CLEANUP_ENABLED=true
GUEST_CLEANUP_AGE_DAYS=60
GUEST_CLEANUP_MAX_PER_RUN=500
# Python only (Java: game.admin.auth.guest.cleanup.cron, AWS: GuestCleanupSchedule).
GUEST_CLEANUP_HOUR=0
GUEST_CLEANUP_MINUTE=42
AWS_TEST_LAMBDA_GUEST_CLEANUP_ENABLED=true
AWS_TEST_LAMBDA_GUEST_CLEANUP_AGE_DAYS=60
AWS_TEST_LAMBDA_GUEST_CLEANUP_MAX_PER_RUN=500
# v0.41.1 — log-size check: a WARN line when a match reaches N log rows (Java/Python; 0 = off).
# AWS has them fixed in template/match.yaml (LOG_WARN_ROWS 5000, LOG_WARN_METADATA_KB 300).
LOG_WARN_ROWS=5000
# v0.41.1 — LIGHT match snapshots kept per match, one per time-end (all backends; 0 = no snapshots).
# AWS has it fixed in template/match.yaml (SNAPSHOT_KEEP_PER_MATCH "10").
SNAPSHOT_KEEP_PER_MATCH=10
# v0.41.4 — size cap in bytes of a match export / import file (Java/Python; 413 above it).
# AWS has it fixed in template/match.yaml (MATCH_EXPORT_MAX_BYTES "5000000").
MATCH_EXPORT_MAX_BYTES=5000000
# v1.7.0 — most seconds one gameplay write adds to the match play time (all backends; AWS: SAM PlayTimeCapSeconds).
PLAY_TIME_CAP_SECONDS=300
# v1.7.0 — choices of PATCH /api/auth/me shown by /api/echo/status (AWS: SupportedLanguages / SupportedThemes).
SUPPORTED_LANGUAGES=en,it
SUPPORTED_THEMES=default,high-contrast
# v1.7.0 step 8 — react-game refetches a match on page return: webkit (Safari, iOS) or all, after this many
# hidden seconds; shown by /api/echo/status (AWS: SAM MatchRefetchBrowsers / MatchRefetchMinHiddenSeconds).
MATCH_REFETCH_BROWSERS=webkit
MATCH_REFETCH_MIN_HIDDEN_SECONDS=30
# The csrfToken issued at guest login / refresh must come back as X-CSRF-TOKEN on
# POST /api/matches. true everywhere; false only to run an old client against a new backend.
CSRF_ENFORCED=true
AWS_TEST_LAMBDA_CSRF_ENFORCED=true
# v0.39.1 — hours after which robottest guests/matches expire via DynamoDB TTL (0 = off, cleanup deletes them)
AWS_TEST_DYNAMODB_ROBOT_TEST_DATA_TTL_HOURS=1
# v1.1.0 — daily smoke test of the test stack (pathsgames-test-SmokeTestFunction), also run after aws_backend_deploy.sh.
# ENABLED=false disables the schedule and skips the post-deploy run; WEBSITE_URL full https:// URL (e.g. https://test.paths.games), empty = check skipped.
AWS_TEST_LAMBDA_SMOKE_TEST_ENABLED=true
AWS_TEST_LAMBDA_SMOKE_WEBSITE_URL=



# Docker Hub: build_docker_test_and_push.sh pushes :test, the EC2 pulls it (public repo).
#note: BACKEND_IMAGE="${DOCKERHUB_USERNAME}/${DOCKERHUB_IMAGE}:${IMAGE_TAG}"
DOCKERHUB_USERNAME_TEST=
DOCKERHUB_IMAGE_TEST=pathsgames-backend  
DOCKERHUB_IMAGE_TAG_TEST=test
# Access token used ONLY by build_docker_test_and_push.sh for the local `docker login`.
DOCKERHUB_TOKEN_TEST=



# ── EC2 test server, plain Docker (code/scripts/test/aws_ec2_with_java_docker) ──
# Used by start.sh / stop.sh / redeploy.sh and build_docker_test_and_push.sh.
AWS_TEST_EC2_KEY_NAME=paths-games-ohio
AWS_TEST_EC2_KEY_PATH=~/.ssh/2026_paths-games-ohio.pem
AWS_TEST_EC2_INSTANCE_TYPE=t3.micro
AWS_TEST_EC2_DB_NAME=pathsgames
AWS_TEST_EC2_DB_USERNAME=pathsgames
AWS_TEST_EC2_DB_PASSWORD=Paths-Games-2026
AWS_TEST_EC2_PUBLIC_PORT=8042
AWS_TEST_EC2_ADMIN_PORT=8044
AWS_TEST_EC2_PUBLIC_CIDRS=0.0.0.0/0
AWS_TEST_EC2_ADMIN_EXTRA_CIDRS=
AWS_TEST_EC2_ROUTE53_RECORD_NAME=api-test-ec2.paths.games
AWS_TEST_EC2_INSTANCE_NAME=api-test-ec2
AWS_TEST_EC2_ENABLE_CLOUDFRONT=true
AWS_TEST_EC2_CLOUDFRONT_PRICE_CLASS=PriceClass_100
AWS_TEST_EC2_CLOUDFRONT_DOMAIN_CERTIFICATE_ARN=arn:...
# EC2 test with python version
DOCKERHUB_IMAGE_TAG_PYTHON_TEST=test-python
AWS_TEST_EC2_PY_INSTANCE_NAME=api-test-server3
AWS_TEST_EC2_PY_ROUTE53_RECORD_NAME=api-test-server3.paths.games
AWS_TEST_EC2_PY_ENABLE_CLOUDFRONT=true
AWS_TEST_EC2_PY_CLOUDFRONT_DOMAIN_CERTIFICATE_ARN=arn:...
AWS_TEST_EC2_PY_CLOUDFRONT_PRICE_CLASS=PriceClass_100


# ── v0.41.0 — public stages, read only by code/scripts/prod/aws_backend_deploy_stage.sh <alpha|beta|prod> ──
# Everything else stays in code/backend/aws/samconfig.toml; empty = keep the samconfig/template value.
# AWS_<S>_LAMBDA_JWT_SECRET is required, its own value per stage (openssl rand -base64 48), never the committed default.
AWS_ALPHA_LAMBDA_JWT_SECRET=
# v1.7.0 — required, its own value per stage (openssl rand -base64 48): HMAC pepper of the banned subjects
AWS_ALPHA_LAMBDA_BANNED_SUBJECT_PEPPER=
AWS_ALPHA_LAMBDA_TURNSTILE_SECRET_KEY=
AWS_ALPHA_APIGW_CUSTOM_DOMAIN=
AWS_ALPHA_ACM_DOMAIN_CERTIFICATE_ARN=
AWS_ALPHA_ROUTE53_DOMAIN_HOSTED_ZONE=
AWS_ALPHA_APIGW_CORS_ORIGINS=
AWS_ALPHA_APIGW_ADMIN_IP_WHITELIST=
AWS_ALPHA_S3_BUCKET_WEBSITE=
AWS_ALPHA_CLOUDFRONT_DISTRIBUTION_ID=
# v0.42.0 — alpha hardening (code/scripts/alpha/README.md): alarm + budget email, budget in USD/month, API throttles.
AWS_ALPHA_SNS_ALARM_EMAIL=
AWS_ALPHA_BUDGETS_LIMIT=10
AWS_ALPHA_APIGW_THROTTLE_RATE=50
AWS_ALPHA_APIGW_THROTTLE_BURST=100
AWS_ALPHA_APIGW_ADMIN_THROTTLE_RATE=5
AWS_ALPHA_APIGW_ADMIN_THROTTLE_BURST=10
# v1.1.0 — daily smoke test per stage (also run after the stage deploy); empty = samconfig/template value
# (enabled true; website https://paths.games on alpha, none on beta/prod).
AWS_ALPHA_LAMBDA_SMOKE_TEST_ENABLED=
AWS_ALPHA_LAMBDA_SMOKE_WEBSITE_URL=
# v1.2.0 — required: Google OAuth client of the stage (prod Google project); empty limit = template value
AWS_ALPHA_LAMBDA_GOOGLE_CLIENT_ID=
AWS_ALPHA_LAMBDA_RATE_LIMIT_GOOGLE_PER_IP=
AWS_ALPHA_LAMBDA_MAX_SESSIONS_PER_USER=
AWS_ALPHA_LAMBDA_COOKIE_SAME_SITE=

# BETA VERSION > 2.0.0
AWS_BETA_LAMBDA_JWT_SECRET=
AWS_BETA_LAMBDA_BANNED_SUBJECT_PEPPER=
AWS_BETA_LAMBDA_TURNSTILE_SECRET_KEY=
AWS_BETA_APIGW_CUSTOM_DOMAIN=
AWS_BETA_ACM_DOMAIN_CERTIFICATE_ARN=
AWS_BETA_ROUTE53_DOMAIN_HOSTED_ZONE=
AWS_BETA_APIGW_CORS_ORIGINS=
AWS_BETA_APIGW_ADMIN_IP_WHITELIST=
AWS_BETA_S3_BUCKET_WEBSITE=
AWS_BETA_CLOUDFRONT_DISTRIBUTION_ID=
AWS_BETA_LAMBDA_SMOKE_TEST_ENABLED=
AWS_BETA_LAMBDA_SMOKE_WEBSITE_URL=
AWS_BETA_LAMBDA_GOOGLE_CLIENT_ID=
AWS_BETA_LAMBDA_RATE_LIMIT_GOOGLE_PER_IP=
AWS_BETA_LAMBDA_MAX_SESSIONS_PER_USER=
AWS_BETA_LAMBDA_COOKIE_SAME_SITE=
# PROD VERSION > 2.0.0
AWS_PROD_LAMBDA_JWT_SECRET=
AWS_PROD_LAMBDA_BANNED_SUBJECT_PEPPER=
AWS_PROD_LAMBDA_TURNSTILE_SECRET_KEY=
AWS_PROD_APIGW_CUSTOM_DOMAIN=
AWS_PROD_ACM_DOMAIN_CERTIFICATE_ARN=
AWS_PROD_ROUTE53_DOMAIN_HOSTED_ZONE=
AWS_PROD_APIGW_CORS_ORIGINS=
AWS_PROD_APIGW_ADMIN_IP_WHITELIST=
AWS_PROD_S3_BUCKET_WEBSITE=
AWS_PROD_CLOUDFRONT_DISTRIBUTION_ID=
AWS_PROD_LAMBDA_SMOKE_TEST_ENABLED=
AWS_PROD_LAMBDA_SMOKE_WEBSITE_URL=
AWS_PROD_LAMBDA_GOOGLE_CLIENT_ID=
AWS_PROD_LAMBDA_RATE_LIMIT_GOOGLE_PER_IP=
AWS_PROD_LAMBDA_MAX_SESSIONS_PER_USER=
AWS_PROD_LAMBDA_COOKIE_SAME_SITE=

