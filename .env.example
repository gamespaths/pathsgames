# Copy this file to .env in the repository root and fill the secret values.
# Do NOT commit .env containing real secrets.

# VERSION
VERSION=0.42.0

# ADmin IP whitelist (comma-separated, no spaces). The current machine's public IP will be added automatically by start.sh, so you can leave this empty if you only need to allow from the current machine.
# Example: ADMIN_IP_WHITELIST=
ADMIN_IP_WHITELIST=1.2.3.4
# v0.41.0 — meaning of an empty allow-list on the AWS test stack: nobody (admin API closed, default) or everybody.
AWS_ADMIN_IP_EMPTY_MEANS_TEST=nobody

# JWT secret used by the backend (dev default is provided but you can override)
# v0.41.0 — set your own: openssl rand -base64 48. Outside dev/test every backend refuses the committed default;
# the Robot scripts, the AWS test deploy, the starter and stress scripts all sign with this value.
JWT_SECRET=

# Admin JWT token used by Robot tests (optional - can be generated dynamically)
# Example: ROBOT_VAR_ADMIN_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# v0.41.0 — mint it with the JWT_SECRET above: code/scripts/dev/mint_admin_token.sh [--days 365]
ROBOT_VAR_ADMIN_TOKEN=

# Sonar scanner login token
SONAR_LOGIN_TOKEN_JAVA=
SONAR_LOGIN_TOKEN=


# AWS Website deployment (optional - only needed if you want to deploy the website to AWS S3/CloudFront)
AWS_S3_BUCKET_WEBSITE=
AWS_S3_BUCKET_WEBSITE_TEST=
AWS_CLOUDFRONT_DISTRIBUTION_ID=
AWS_CLOUDFRONT_DISTRIBUTION_ID_TEST=

# AWS Backend CloudFormation params (optional - only needed if you want to deploy the backend to AWS using CloudFormation)
AWS_ENVIRONMENT_NAME_TEST=test
AWS_STACK_NAME_TEST=
AWS_S3_BUCKET_BASE_TEST=
AWS_REGION_TEST=us-east-2
AWS_REGION_PROD=us-east-1


AWS_CUSTOM_DOMAIN_TEST=xxxx.domain.com
AWS_DOMAIN_CERTIFICATE_ARN_TEST=arn:aws:acm:us-east-2:xxxxxxxxxx:certificate/yyyyyyyyyy
AWS_DOMAIN_HOSTED_ZONE_TEST=Zzzzzzzzzzzzzzzzzzzzz
# Comma-separated CORS origins (no spaces). Leave empty to use the template default (localhost only).
AWS_CORS_ORIGINS_TEST=http://localhost:3000,http://localhost:5172,http://localhost:5174,http://localhost:5500
# Admin HTTP API of the test stack (AdminApiUrl output); empty = the Robot script reads it from CloudFormation.
AWS_ADMIN_API_URL_TEST=


# Cloudflare Turnstile keys.
# For dev/AWS robot tests use the Cloudflare "always-passes" test keys so the
# siteverify API accepts any token without a real browser widget:
#   TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# For production use the real keys from the Cloudflare dashboard.
TURNSTILE_SITE_KEY=0xAAAAA
TURNSTILE_SECRET_KEY=0xAAAAA
# emtpy for prod, into test env need to set a token value to bypass the turnstile in robot tests, can be any string when using the test keys
TURNSTILE_BYPASS_TOKEN_TEST=
# Bypass token sent by Robot and the AWS stress run; the AWS test deploy prefers it to TURNSTILE_BYPASS_TOKEN_TEST.
TURNSTILE_BYPASS_TOKEN_ROBOT=

# v0.37.7 — Step 41 security. Rate limits are per source IP per window (fixed window):
# 0 disables a bucket. The same names without _TEST are read by the
# Java (application.yml) and Python (config.py) backends; the AWS test stack takes the _TEST ones.
# v0.41.0 — code defaults 20/20 per IP per hour and 10 matches per guest per day; the Robot, starter
# and EC2 scripts force 0 (Robot mints hundreds of guests from one address), the AWS test deploy uses the _TEST ones.
RATE_LIMIT_GUEST_PER_IP=20
RATE_LIMIT_MATCH_PER_IP=20
RATE_LIMIT_WINDOW_SECONDS=3600
RATE_LIMIT_MATCH_PER_GUEST=10
RATE_LIMIT_MATCH_PER_GUEST_WINDOW_SECONDS=86400
AWS_RATE_LIMIT_GUEST_PER_IP_TEST=0
AWS_RATE_LIMIT_MATCH_PER_IP_TEST=0
AWS_RATE_LIMIT_WINDOW_SECONDS_TEST=3600
AWS_RATE_LIMIT_MATCH_PER_GUEST_TEST=0
AWS_RATE_LIMIT_MATCH_PER_GUEST_WINDOW_SECONDS_TEST=86400
# v0.41.0 — daily cleanup of the guests idle for N days that created no match (00:42 UTC, at most N per run).
GUEST_CLEANUP_ENABLED=true
GUEST_CLEANUP_AGE_DAYS=60
GUEST_CLEANUP_MAX_PER_RUN=500
# Python only (Java: game.admin.auth.guest.cleanup.cron, AWS: GuestCleanupSchedule).
GUEST_CLEANUP_HOUR=0
GUEST_CLEANUP_MINUTE=42
AWS_GUEST_CLEANUP_ENABLED_TEST=true
AWS_GUEST_CLEANUP_AGE_DAYS_TEST=60
AWS_GUEST_CLEANUP_MAX_PER_RUN_TEST=500
# v0.41.1 — log-size check: a WARN line when a match reaches N log rows (Java/Python; 0 = off).
# AWS has them fixed in template/match.yaml (LOG_WARN_ROWS 5000, LOG_WARN_METADATA_KB 300).
LOG_WARN_ROWS=5000
# v0.41.1 — LIGHT match snapshots kept per match, one per time-end (all backends; 0 = no snapshots).
# AWS has it fixed in template/match.yaml (SNAPSHOT_KEEP_PER_MATCH "10").
SNAPSHOT_KEEP_PER_MATCH=10
# v0.41.4 — size cap in bytes of a match export / import file (Java/Python; 413 above it).
# AWS has it fixed in template/match.yaml (MATCH_EXPORT_MAX_BYTES "5000000").
MATCH_EXPORT_MAX_BYTES=5000000
# The csrfToken issued at guest login / refresh must come back as X-CSRF-TOKEN on
# POST /api/matches. true everywhere; false only to run an old client against a new backend.
CSRF_ENFORCED=true
AWS_CSRF_ENFORCED_TEST=true
# v0.39.1 — hours after which robottest guests/matches expire via DynamoDB TTL (0 = off, cleanup deletes them)
AWS_ROBOT_TEST_DATA_TTL_HOURS_TEST=1



# Docker Hub: build_docker_test_and_push.sh pushes :test, the EC2 pulls it (public repo).
#note: BACKEND_IMAGE="${DOCKERHUB_USERNAME}/${DOCKERHUB_IMAGE}:${IMAGE_TAG}"
DOCKERHUB_USERNAME_TEST=
DOCKERHUB_IMAGE_TEST=pathsgames-backend  
DOCKERHUB_IMAGE_TAG_TEST=test
# Access token used ONLY by build_docker_test_and_push.sh for the local `docker login`.
DOCKERHUB_TOKEN_TEST=



# ── EC2 test server, plain Docker (code/scripts/test/aws_ec2_with_java_docker) ──
# Used by start.sh / stop.sh / redeploy.sh and build_docker_test_and_push.sh.
EC2_KEY_NAME_TEST_EC2=paths-games-ohio
EC2_KEY_PATH_TEST_EC2=~/.ssh/2026_paths-games-ohio.pem
EC2_INSTANCE_TYPE_TEST_EC2=t3.micro
DB_NAME_TEST_EC2=pathsgames
DB_USERNAME_TEST_EC2=pathsgames
DB_PASSWORD_TEST_EC2=Paths-Games-2026
PUBLIC_PORT_TEST_EC2=8042
ADMIN_PORT_TEST_EC2=8044
PUBLIC_CIDRS_TEST_EC2=0.0.0.0/0
ADMIN_EXTRA_CIDRS_TEST_EC2=
ROUTE53_RECORD_NAME_TEST_EC2=api-test-ec2.paths.games
INSTANCE_NAME_TEST_EC2=api-test-ec2
ENABLE_CLOUDFRONT_TEST_EC2=true
CLOUDFRONT_PRICE_CLASS_TEST_EC2=PriceClass_100
CLOUDFRONT_DOMAIN_CERTIFICATE_ARN_TEST_EC2=arn:...
# EC2 test with python version
DOCKERHUB_IMAGE_TAG_PYTHON_TEST=test-python
INSTANCE_NAME_TEST_EC2_PY=api-test-server3
ROUTE53_RECORD_NAME_TEST_EC2_PY=api-test-server3.paths.games
ENABLE_CLOUDFRONT_TEST_EC2_PY=true
CLOUDFRONT_DOMAIN_CERTIFICATE_ARN_TEST_EC2_PY=arn:...
CLOUDFRONT_PRICE_CLASS_TEST_EC2_PY=PriceClass_100


# ── v0.41.0 — public stages, read only by code/scripts/prod/aws_backend_deploy_stage.sh <alpha|beta|prod> ──
# Everything else stays in code/backend/aws/samconfig.toml; empty = keep the samconfig/template value.
# AWS_JWT_SECRET_<S> is required, its own value per stage (openssl rand -base64 48), never the committed default.
AWS_JWT_SECRET_ALPHA=
AWS_TURNSTILE_SECRET_KEY_ALPHA=
AWS_CUSTOM_DOMAIN_ALPHA=
AWS_DOMAIN_CERTIFICATE_ARN_ALPHA=
AWS_DOMAIN_HOSTED_ZONE_ALPHA=
AWS_CORS_ORIGINS_ALPHA=
AWS_ADMIN_IP_WHITELIST_ALPHA=
AWS_S3_BUCKET_WEBSITE_ALPHA=
AWS_CLOUDFRONT_DISTRIBUTION_ID_ALPHA=
AWS_JWT_SECRET_BETA=
AWS_TURNSTILE_SECRET_KEY_BETA=
AWS_CUSTOM_DOMAIN_BETA=
AWS_DOMAIN_CERTIFICATE_ARN_BETA=
AWS_DOMAIN_HOSTED_ZONE_BETA=
AWS_CORS_ORIGINS_BETA=
AWS_ADMIN_IP_WHITELIST_BETA=
AWS_S3_BUCKET_WEBSITE_BETA=
AWS_CLOUDFRONT_DISTRIBUTION_ID_BETA=
AWS_JWT_SECRET_PROD=
AWS_TURNSTILE_SECRET_KEY_PROD=
AWS_CUSTOM_DOMAIN_PROD=
AWS_DOMAIN_CERTIFICATE_ARN_PROD=
AWS_DOMAIN_HOSTED_ZONE_PROD=
AWS_CORS_ORIGINS_PROD=
AWS_ADMIN_IP_WHITELIST_PROD=
AWS_S3_BUCKET_WEBSITE_PROD=
AWS_CLOUDFRONT_DISTRIBUTION_ID_PROD=
